# The release image, built by goreleaser from the binaries it releases, so that the image and the
# archives hold the same build. Keep the base image in step with the Dockerfile.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/spiffex /spiffex
USER 65532:65532
ENTRYPOINT ["/spiffex"]
