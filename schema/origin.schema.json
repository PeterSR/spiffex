{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeterSR/spiffex/schema/origin.schema.json",
  "title": "spiffex origin",
  "description": "One way identities come in: a provider, its parameters, and the origin's own naming and admission (SPEC section 4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider"],
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "with": {
      "description": "Values for the provider's parameters.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
      "additionalProperties": {
        "type": ["string", "array"],
        "items": { "type": "string" }
      }
    },
    "prefix": {
      "description": "The path every SPIFFE ID of the origin starts with; /<origin name> when absent.",
      "type": "string",
      "pattern": "^/$|^(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]{0,254}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,253}|\\.\\.[A-Za-z0-9._-]{1,253}))+$"
    },
    "name": {
      "description": "The name template, in place of the provider's.",
      "type": "string"
    },
    "require": { "$ref": "#/$defs/claimPaths" },
    "match": { "$ref": "#/$defs/conditions" },
    "deny": { "$ref": "#/$defs/conditions" },
    "audiences": { "$ref": "#/$defs/patterns" },
    "members": {
      "type": "object",
      "propertyNames": { "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]{0,254}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,253}|\\.\\.[A-Za-z0-9._-]{1,253})$" },
      "additionalProperties": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "claimPath": {
      "type": "string",
      "pattern": "^(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
    },
    "claimPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/claimPath" }
    },
    "patterns": {
      "description": "A pattern or a list of patterns; * stands for any run of characters.",
      "type": ["string", "array"],
      "minLength": 1,
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "conditions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/claimPath" },
      "additionalProperties": { "$ref": "#/$defs/patterns" }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "description": "Public keys, each a PEM PUBLIC KEY block or a JWK.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": ["string", "object"],
            "required": ["kty"]
          }
        }
      }
    }
  }
}
