{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeterSR/spiffex/schema/state.schema.json",
  "title": "spiffex state",
  "description": "The issuer's state: origins, providers and grants, each keyed by name (SPEC section 6.1).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "origins": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "origin.schema.json" }
    },
    "providers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "provider.schema.json" }
    },
    "grants": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/grant" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "grant": {
      "description": "Permission for SPIFFE identities to read and change the state (SPEC section 8.2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["who", "can", "on"],
      "properties": {
        "who": {
          "description": "A SPIFFE ID pattern: segments may be *, the last may be **.",
          "type": "string",
          "pattern": "^spiffe://[^/]+(/[^/]+)+$"
        },
        "can": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["read", "write", "delegate"] }
        },
        "on": {
          "description": "Scopes: paths in the form of an origin prefix; / is everything.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/$|^(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]{0,254}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,253}|\\.\\.[A-Za-z0-9._-]{1,253}))+$"
          }
        }
      }
    }
  }
}
